{
  "name": "prism-visual-regression-inspector",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A local visual regression workbench with real Chromium capture and persistent pixel-diff reports.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build",
    "start": "node server/index.mjs",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "test:browser": "node scripts/browser-smoke.mjs",
    "check": "npm run test && npm run build && npm run test:browser"
  },
  "dependencies": {
    "express": "^5.3.0",
    "lucide-react": "^1.55.0",
    "pixelmatch": "^8.0.0",
    "playwright": "^1.64.0",
    "pngjs": "^7.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
